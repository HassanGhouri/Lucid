# OpenAI API key from https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Application display name used by FastAPI metadata.
APP_NAME=Lucid

# Maximum tokenizer-estimated tokens per ingested chunk.
MAX_TOKENS_PER_CHUNK=350

# Number of paragraphs repeated between adjacent chunks.
OVERLAP_PARAGRAPHS=1

# Qdrant HTTP URL; use http://qdrant:6333 inside Docker Compose.
QDRANT_URL=http://localhost:6333

# Qdrant Cloud API key; leave blank for local Docker/Qdrant without auth.
QDRANT_API_KEY=

# Qdrant collection that stores Lucid chunks.
QDRANT_COLLECTION_NAME=lucid_chunks

# Dense embedding model used for semantic retrieval.
DENSE_EMBEDDING_MODEL_CHECKPOINT=sentence-transformers/all-MiniLM-L6-v2

# Batch size for dense document embedding.
DENSE_EMBEDDING_BATCH_SIZE=64

# Dense vector dimension for the embedding model.
DENSE_VECTOR_SIZE=384

# Sparse embedding model used for BM25-style retrieval.
SPARSE_EMBEDDING_MODEL_CHECKPOINT=Qdrant/bm25

# Qdrant dense vector name.
DENSE_VECTOR_NAME=dense

# Qdrant sparse vector name.
SPARSE_VECTOR_NAME=sparse

# Number of dense results retrieved before fusion.
DENSE_TOP_K=20

# Number of sparse results retrieved before fusion.
SPARSE_TOP_K=20

# Number of fused retrieval results kept before reranking.
FUSION_TOP_K=30

# Reciprocal Rank Fusion smoothing constant.
RRF_K=60

# CrossEncoder reranker model.
CROSS_ENCODER_MODEL_CHECKPOINT=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of reranked chunks sent to answer generation.
RERANK_TOP_K=8

# OpenAI model used for answer and flashcard generation.
OPENAI_MODEL=gpt-4.1-mini

# Maximum output tokens for generated answers.
MAX_OUTPUT_TOKENS=500

# OpenAI model used for query rewriting.
QUERY_REWRITE_MODEL=gpt-4.1-mini

# OpenAI model used for grounding/confidence judging.
JUDGE_MODEL=gpt-4.1-mini

# Enable LangSmith tracing; set true in deployed environments if tracing is desired.
LANGSMITH_TRACING=false

# LangSmith API key from https://smith.langchain.com.
LANGSMITH_API_KEY=

# LangSmith project name for traces.
LANGSMITH_PROJECT=Lucid

# LangSmith API endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Maximum text characters sent into trace metadata.
TRACE_MAX_TEXT_CHARS=1200

# Uvicorn worker count used by scripts/run_server.py.
WORKERS=2

# slowapi limit for ask endpoints, e.g. 20/minute.
RATE_LIMIT_ASK=20/minute

# slowapi limit for PDF ingestion endpoint, e.g. 20/hour.
RATE_LIMIT_INGEST=20/hour

# OpenAI per-call timeout in seconds.
OPENAI_TIMEOUT_SECONDS=45.0

# Default request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=90.0

# PDF ingestion request timeout in seconds.
INGEST_TIMEOUT_SECONDS=600.0

# Comma-separated full origins allowed by CORS, e.g. https://yourdomain.com,https://lucid.app.
CORS_ALLOWED_ORIGINS=*

# Hours before private anonymous-session uploads are eligible for cleanup.
PRIVATE_UPLOAD_TTL_HOURS=24

# Minimum seconds between opportunistic private-upload cleanup runs.
PRIVATE_UPLOAD_CLEANUP_INTERVAL_SECONDS=3600

# Frontend/backend URL for Streamlit and helper scripts; in Docker Compose use http://backend:8000.
BACKEND_URL=http://localhost:8000

# Directory containing demo PDFs for scripts/load_demo_docs.py.
PDF_DIR=data/uploads
