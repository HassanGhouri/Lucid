FROM python:3.11-slim AS builder

ENV PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .

# Install CPU-only torch from PyTorch's dedicated CPU index BEFORE the main
# requirements install. Avoids pulling nvidia-cublas, nvidia-cudnn,
# nvidia-cufft, triton, and other CUDA libraries (~3 GB) that can't be used
# on Railway (no GPU instances). The subsequent `pip install -r` sees
# torch==2.12.0 is already satisfied and skips reinstalling.
RUN pip install --user torch==2.12.0 torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install --user -r requirements.txt


FROM python:3.11-slim AS runtime

ENV HF_HOME=/app/models \
    PATH=/home/app/.local/bin:$PATH \
    PYTHONPATH=/home/app/.local/lib/python3.11/site-packages \
    PYTHONUNBUFFERED=1

# System libs required by docling_ibm_models -> opencv-python (libGL +
# glib). python:3.11-slim is too minimal to satisfy these by default.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/models \
    && chown -R app:app /app

WORKDIR /app
# Setting ownership at COPY time (--chown) instead of with a follow-up
# `chown -R` keeps everything in one layer and avoids rewriting metadata
# for the ~hundreds of thousands of files under /home/app/.local. The
# trailing chown step was taking >20 min on Railway and tripping the
# build heartbeat timeout; this gets us back to a single fast layer.
COPY --chown=app:app --from=builder /root/.local /home/app/.local
COPY --chown=app:app requirements.txt .

COPY --chown=app:app backend ./backend
COPY --chown=app:app scripts ./scripts

USER app
EXPOSE 8000

CMD ["python", "-m", "scripts.run_server"]
